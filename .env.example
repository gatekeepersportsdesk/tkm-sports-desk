# Gemini API key for server-side sportsbook screenshot OCR (/api/ocr-lines)
GEMINI_API_KEY=

# Optional: TheOddsAPI key for live odds movement (/api/odds/movement)
THE_ODDS_API_KEY=

# Optional: Set to "true" to enable Vite HMR in server.ts (disabled by default)
GATEKEEP_ENABLE_HMR=false
DISABLE_HMR=true
